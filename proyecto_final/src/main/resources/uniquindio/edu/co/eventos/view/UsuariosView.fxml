<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uniquindio.edu.co.eventos.controller.UsuariosController"
      spacing="15"
      stylesheets="@../css/styles.css"
      styleClass="view-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion de Usuarios" styleClass="section-title"/>

    <HBox spacing="10">
        <TextField fx:id="txtBuscarUsuario" promptText="Buscar por nombre o correo..." prefWidth="300"/>
        <Button text="Buscar" onAction="#buscarUsuario" styleClass="primary-button"/>
        <Button text="Cargar todos" onAction="#cargarUsuarios" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" prefHeight="400">
        <columns>
            <TableColumn fx:id="colIdUsuario" text="ID" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="220"/>
            <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Ver compras" onAction="#verComprasUsuario" styleClass="secondary-button"/>
        <Button text="Actualizar tabla" onAction="#cargarUsuarios" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" styleClass="info-label"/>

</VBox>
