<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uniquindio.edu.co.eventos.controller.EventosController"
      spacing="15"
      stylesheets="@../css/styles.css"
      styleClass="view-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion de Eventos" styleClass="section-title"/>

    <HBox spacing="10">
        <TextField fx:id="txtBuscar" promptText="Buscar evento..." prefWidth="250"/>
        <ComboBox fx:id="cmbCategoria" promptText="Categoria" prefWidth="150"/>
        <TextField fx:id="txtCiudad" promptText="Ciudad" prefWidth="150"/>
        <Button text="Filtrar" onAction="#filtrarEventos" styleClass="primary-button"/>
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="tablaEventos" prefHeight="350">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="130"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="160"/>
            <TableColumn fx:id="colPrecio" text="Precio base" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Ver detalle" onAction="#verDetalleEvento" styleClass="secondary-button"/>
        <Button text="Comprar entrada" onAction="#comprarEvento" styleClass="primary-button"/>
        <Button text="Publicar" onAction="#publicarEvento" styleClass="secondary-button"/>
        <Button text="Pausar" onAction="#pausarEvento" styleClass="secondary-button"/>
        <Button text="Cancelar" onAction="#cancelarEvento" styleClass="danger-button"/>
    </HBox>

    <Label fx:id="lblMensaje" text="" styleClass="info-label"/>

</VBox>
