<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.edu.co.eventos.controller.LoginController"
            stylesheets="@../css/styles.css"
            prefWidth="900"
            prefHeight="600"
            styleClass="root-background">

    <center>
        <VBox alignment="CENTER" spacing="15" styleClass="login-card">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <ImageView fitWidth="120" fitHeight="120" preserveRatio="true">
                <image>
                    <Image url="@../img/uniquindio.png"/>
                </image>
            </ImageView>

            <Label text="Plataforma de Eventos" styleClass="title-label"/>
            <Label text="Universidad del Quindio" styleClass="subtitle-label"/>

            <TextField fx:id="txtCorreo" promptText="Correo" prefWidth="280"/>
            <PasswordField fx:id="txtContrasena" promptText="Contrasena" prefWidth="280"/>

            <ComboBox fx:id="cmbTipoUsuario" promptText="Tipo de usuario" prefWidth="280"/>

            <Button text="Iniciar sesion"
                    onAction="#iniciarSesion"
                    prefWidth="280"
                    styleClass="primary-button"/>

            <Button text="Registrar usuario"
                    onAction="#registrarUsuario"
                    prefWidth="280"
                    styleClass="secondary-button"/>

            <Label fx:id="lblMensaje" text="" styleClass="error-label"/>
        </VBox>
    </center>

</BorderPane>
