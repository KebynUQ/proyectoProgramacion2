<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uniquindio.edu.co.eventos.controller.ComprasController"
      spacing="15"
      stylesheets="@../css/styles.css"
      styleClass="view-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Compra de Entradas" styleClass="section-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Evento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbEvento" promptText="Seleccione evento" prefWidth="250"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Zona:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbZona" promptText="Seleccione zona" prefWidth="250"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Asiento:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbAsiento" promptText="Seleccione asiento" prefWidth="250"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Metodo de pago:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbMetodoPago" promptText="Seleccione metodo" prefWidth="250"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Servicios adicionales" styleClass="subtitle-label"/>

    <HBox spacing="15">
        <CheckBox fx:id="chkVIP" text="Servicio VIP"/>
        <CheckBox fx:id="chkSeguro" text="Seguro de cancelacion"/>
        <CheckBox fx:id="chkMerchandising" text="Merchandising"/>
        <CheckBox fx:id="chkParqueadero" text="Parqueadero"/>
        <CheckBox fx:id="chkAcceso" text="Acceso preferencial"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Calcular total" onAction="#calcularTotal" styleClass="secondary-button"/>
        <Button text="Confirmar compra" onAction="#confirmarCompra" styleClass="primary-button"/>
        <Label text="Total:" styleClass="bold-label"/>
        <Label fx:id="lblTotal" text="$0"/>
    </HBox>

    <TableView fx:id="tablaCompras" prefHeight="250">
        <columns>
            <TableColumn fx:id="colIdCompra" text="ID" prefWidth="100"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="180"/>
            <TableColumn fx:id="colEvento" text="Evento" prefWidth="180"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="lblMensaje" text="" styleClass="info-label"/>

</VBox>
