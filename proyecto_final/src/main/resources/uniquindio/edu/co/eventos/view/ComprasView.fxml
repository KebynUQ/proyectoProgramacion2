<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uniquindio.edu.co.eventos.controller.ComprasController"
      spacing="15"
      stylesheets="@../css/styles.css"
      styleClass="view-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTituloVista" text="Mis compras" styleClass="section-title"/>

    <TableView fx:id="tablaCompras" prefHeight="420">
        <columns>
            <TableColumn fx:id="colIdCompra" text="ID" prefWidth="100"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="160"/>
            <TableColumn fx:id="colEvento" text="Evento" prefWidth="180"/>
            <TableColumn fx:id="colZona" text="Zona" prefWidth="120"/>
            <TableColumn fx:id="colAsiento" text="Asiento" prefWidth="140"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="180"/>
        </columns>
    </TableView>

    <Label fx:id="lblMensaje" text="" styleClass="info-label"/>

</VBox>
